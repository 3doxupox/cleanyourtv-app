<?xml version="1.0" encoding="utf-8"?>
<!--
  Clean Your TV, :feature:launcher. English source strings.
  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
  no Android plurals elements. Counts go through the plural selector.
  Screens: M2 Home screen, the theme picker, the dock sheet (S3b, own copy in this module).
-->
<resources>

    <!-- Shared button words -->
    <string name="action_back">Back</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_done">Done</string>
    <string name="action_undo">Undo</string>

    <!-- Credential prompt (D17), raised by "Restore mine" and "Use the TV's own home screen" -->
    <string name="gate_title">Confirm it\'s you</string>
    <string name="gate_subtitle">Before we change anything on {tv}</string>
    <string name="gate_negative">Cancel</string>
    <string name="gate_failed">We couldn\'t confirm it\'s you, so nothing was changed.</string>

    <!-- M2 Home screen -->
    <string name="home_title">Home screen</string>
    <string name="home_row_dock">Dock</string>
    <!-- The Dock row's subtitle when rows sit under the dock: the dock's apps, then how many more -->
    <string name="home_row_dock_rows">{names}, plus {count, plural, one {# app} other {# apps}} below</string>
    <string name="home_row_look">Look</string>
    <string name="home_row_stock">Use the TV\'s own home screen</string>
    <string name="home_row_stock_note">Brings back the TV\'s own home screen. Ours stays installed, so you can switch again.</string>
    <string name="home_drift_banner">The home screen settings on the TV changed since you set them.</string>
    <string name="home_drift_restore">Restore mine</string>
    <string name="home_applying">Updating the home screen on the TV...</string>
    <string name="home_snackbar_done">Done.</string>

    <!-- M2 Use the TV's own home screen: preview, then narration -->
    <string name="home_stock_preview_title">Use the TV\'s own home screen?</string>
    <string name="home_stock_preview_body">We\'ll switch the TV\'s own home screen back on and set it as the home screen. The new home screen stays installed.</string>
    <string name="home_stock_confirm">Use the TV\'s own</string>
    <string name="home_stock_working">Putting the TV\'s own home screen back...</string>
    <string name="home_stock_done">The TV\'s own home screen is back. Ours is still installed.</string>

    <!-- M2 Look (theme picker) -->
    <string name="theme_title">Look</string>
    <string name="theme_default">Default</string>
    <string name="theme_default_desc">A black background with four apps along the bottom.</string>
    <string name="theme_aurora">Aurora</string>
    <string name="theme_aurora_desc">A deep blue background with a soft glow behind the apps.</string>
    <string name="theme_six_columns">Six columns</string>
    <string name="theme_six_columns_desc">Six apps across, so more fit on the screen.</string>
    <string name="theme_card_cd">{name}. {description}</string>
    <string name="theme_card_selected_cd">{name}, selected. {description}</string>

    <!-- S3b Your dock (sheet) -->
    <string name="dock_title">Your dock</string>
    <string name="dock_body">Up to {count, spellout} along the bottom. Hold an app and drag it to change the order.</string>

</resources>
